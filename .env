# =============================================================================
# IP Mudra — local & secret configuration (do not commit; see .env.example)
# Copy missing values from Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- EmailJS (contact & enquiry forms) — exposed to browser (VITE_*) ---
VITE_EMAILJS_SERVICE_ID=service_9l6knyf
VITE_EMAILJS_TEMPLATE_ID=template_fayl6uc
VITE_EMAILJS_PUBLIC_KEY=HDBRU9joBSlUf4Hoj

# --- Google Tag Manager: installed in index.html (GTM-PXDTDBST) ---
# Optional extra GA4 only if not configured inside GTM (avoid double counting)
VITE_GA_MEASUREMENT_ID=

# --- Google reviews (client) ---
VITE_GOOGLE_REVIEWS_URL=https://www.google.com/maps/place/IP+MUDRA+ASSOCIATES/@28.6326892,77.2336766,17z
VITE_GOOGLE_RATING=5.0
VITE_GOOGLE_TOTAL_REVIEWS=232

# --- Google Places API (server only — Vercel api/google-reviews.js) ---
# Do NOT use VITE_ prefix; these stay on the server
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=IP MUDRA ASSOCIATES New Delhi
GOOGLE_RATING=5.0
GOOGLE_TOTAL_REVIEWS=232

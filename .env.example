# EmailJS (contact forms)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics 4 — add your Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Business Profile reviews link (optional)
VITE_GOOGLE_REVIEWS_URL=https://www.google.com/maps/place/IP+MUDRA+ASSOCIATES/@28.6326892,77.2336766,17z

# Client-side fallback stats (used when API is unavailable)
VITE_GOOGLE_RATING=5.0
VITE_GOOGLE_TOTAL_REVIEWS=232

# Server-side: live Google reviews (set in Vercel env, not VITE_)
# Enable "Places API (New)" in Google Cloud Console
# GOOGLE_PLACES_API_KEY=your_google_places_api_key
# GOOGLE_PLACE_ID=ChIJ... (optional — auto-searches "IP MUDRA ASSOCIATES New Delhi" if omitted)
# GOOGLE_PLACE_QUERY=IP MUDRA ASSOCIATES New Delhi
# GOOGLE_RATING=5.0
# GOOGLE_TOTAL_REVIEWS=232

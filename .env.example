# =============================================================================
# IP Mudra — environment template (safe to commit)
# Copy to .env and fill in real values:  cp .env.example .env
# =============================================================================

# --- EmailJS (contact forms) ---
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# --- Analytics ---
# GTM container GTM-PXDTDBST is in index.html
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Google reviews (client fallbacks & link) ---
VITE_GOOGLE_REVIEWS_URL=https://www.google.com/maps/place/IP+MUDRA+ASSOCIATES/@28.6326892,77.2336766,17z
VITE_GOOGLE_RATING=5.0
VITE_GOOGLE_TOTAL_REVIEWS=232

# --- Google Places (server — set same keys on Vercel for production) ---
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=IP MUDRA ASSOCIATES New Delhi
GOOGLE_RATING=5.0
GOOGLE_TOTAL_REVIEWS=232
